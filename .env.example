
# Public site URL. Leave unset in production/Vercel: it defaults to https://www.labrity.com.
# Set it only for a different domain (never http://localhost:3000 in production).
# NEXT_PUBLIC_URL=https://www.labrity.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Optional: extra allowed form origins, comma separated (e.g. a preview domain).
# FORM_EXTRA_ORIGINS=

# Anti-bot form token signing secret (src/app/api/telegram/route.ts).
# Use a long random value (openssl rand -base64 48). Set it in Vercel; never commit it.
# If unset, the token check is skipped (warning logged) so customers can still write.
# FORM_SIGNING_SECRET=

# Testing only: accept forms after all checks but do NOT send to Telegram. Never set in production.
# FORM_DRY_RUN=1

# Consent log (Einwilligungsnachweis): private Telegram chat that archives cookie choices.
# Create a private group, add the bot, put its chat id here. Without it only the hosting log is written.
# Optional dedicated bot for the log (falls back to TELEGRAM_BOT_TOKEN).
# TELEGRAM_CONSENT_BOT_TOKEN=
# TELEGRAM_CONSENT_CHAT_ID=
