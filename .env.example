
NEXT_PUBLIC_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: extra allowed form origins, comma separated (e.g. a preview domain).
# FORM_EXTRA_ORIGINS=

# Anti-bot form token signing secret (src/app/api/telegram/route.ts).
# Use a long random value (openssl rand -base64 48). Set it in Vercel; never commit it.
# If unset, the token check is skipped (warning logged) so customers can still write.
# FORM_SIGNING_SECRET=
