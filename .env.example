
NEXT_PUBLIC_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: secret for the signed anti-bot form token (src/app/api/telegram/route.ts).
# If omitted, TELEGRAM_BOT_TOKEN is used as the signing key, so nothing new is required.
# FORM_TOKEN_SECRET=
# Optional: extra allowed form origins, comma separated (e.g. a preview domain).
# FORM_EXTRA_ORIGINS=
