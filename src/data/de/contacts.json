{
  "contactsTitle": "Kontakt",

  "inputs": [
    {
      "name": {
        "textarea": false,
        "label": "Ihr Name",
        "name": "name",
        "placeholder": "Name eingeben",
        "validation": {
          "required": {
            "value": true,
            "message": "Bitte geben Sie Ihren Namen ein"
          },
          "pattern": {
            "value": "^(?!.*(?:[ -]{2,}| -| - |^[ -]|^-))[A-Za-zÄäÖöÜüẞßА-Яа-яЁёІіЇїЄєҐґ'ʼ` -]+$",
            "message": "Bitte geben Sie einen gültigen Namen ein"
          },
          "minLength": {
            "value": 2,
            "message": "Der Name muss mindestens 2 Zeichen enthalten"
          },
          "maxLength": {
            "value": 30,
            "message": "Maximal 30 Zeichen erlaubt"
          }
        }
      }
    },

    {
      "name": {
        "textarea": false,
        "label": "Telefonnummer",
        "name": "phone",
        "placeholder": "+49 123 456789",
        "validation": {
          "required": {
            "value": true,
            "message": "Bitte geben Sie Ihre Telefonnummer ein"
          },
          "pattern": {
            "value": "^\\+?[0-9\\s()-]{6,20}$",
            "message": "Bitte geben Sie eine gültige Telefonnummer ein"
          },
          "minLength": {
            "value": 6,
            "message": "Mindestens 6 Zeichen erforderlich"
          },
          "maxLength": {
            "value": 20,
            "message": "Maximal 20 Zeichen erlaubt"
          }
        }
      }
    },

    {
      "name": {
        "textarea": true,
        "label": "Nachricht",
        "name": "message",
        "placeholder": "Beschreiben Sie kurz Ihr Anliegen",
        "validation": {
          "required": {
            "value": false,
            "message": ""
          },
          "pattern": {
            "value": "^[\\s\\S]{0,500}$",
            "message": ""
          }
        }
      }
    }
  ],

  "checkBox": {
    "name": "checkbox",
    "label": "Ich stimme der Verarbeitung meiner personenbezogenen Daten gemäß der ",
    "ariaLabel": "Checkbox zur Zustimmung der Datenverarbeitung",
    "validation": {
      "required": {
        "value": true,
        "message": "Bitte bestätigen Sie die Datenschutzerklärung"
      }
    },
    "conditionsLink": "Datenschutz"
  },

  "location": {
    "iconLabel": "Standort-Symbol",
    "label": "Stadt"
  },

  "email": "kontakt@massage-studio.de",
  "phone": "+49 176 12345678"
}
