{
  "contactsTitle": "Contact",

  "inputs": [
    {
      "name": {
        "textarea": false,
        "label": "Your Name",
        "name": "name",
        "placeholder": "Enter your name",
        "validation": {
          "required": {
            "value": true,
            "message": "Please enter your name"
          },
          "pattern": {
            "value": "^(?!.*(?:[ -]{2,}| -| - |^[ -]|^-))[A-Za-zÄäÖöÜüẞßА-Яа-яЁёІіЇїЄєҐґ'ʼ` -]+$",
            "message": "Please enter a valid name"
          },
          "minLength": {
            "value": 2,
            "message": "The name must contain at least 2 characters"
          },
          "maxLength": {
            "value": 30,
            "message": "Maximum length: 30 characters"
          }
        }
      }
    },

    {
      "name": {
        "textarea": false,
        "label": "Phone Number",
        "name": "phone",
        "placeholder": "+49 123 456789",
        "validation": {
          "required": {
            "value": true,
            "message": "Please enter your phone number"
          },
          "pattern": {
            "value": "^\\+?[0-9\\s()-]{6,20}$",
            "message": "Please enter a valid phone number"
          },
          "minLength": {
            "value": 6,
            "message": "At least 6 characters required"
          },
          "maxLength": {
            "value": 20,
            "message": "Maximum 20 characters allowed"
          }
        }
      }
    },

    {
      "name": {
        "textarea": true,
        "label": "Message",
        "name": "message",
        "placeholder": "Briefly describe your request",
        "validation": {
          "required": {
            "value": false,
            "message": ""
          },
          "pattern": {
            "value": "^[\\s\\S]{0,500}$",
            "message": ""
          }
        }
      }
    }
  ],

  "checkBox": {
    "name": "checkbox",
    "label": "I agree to the processing of my personal data according to the ",
    "ariaLabel": "Checkbox for agreeing to personal data processing",
    "validation": {
      "required": {
        "value": true,
        "message": "Please confirm the privacy policy"
      }
    },
    "conditionsLink": "Privacy Policy"
  },

  "location": {
    "iconLabel": "Location icon",
    "label": "Stadt"
  },

  "email": "contact@massage-studio.com",
  "phone": "+49 176 12345678"
}
